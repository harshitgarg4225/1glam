PORT=3000

# Deployment environment: development | staging | production.
# In staging/production the app refuses to boot without DATABASE_URL and
# TOKEN_ENCRYPTION_KEY (no ephemeral storage, no plaintext tokens).
APP_ENV=development

APP_BASE_URL=http://localhost:3000
# Minimum 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-replace-with-32-char-secret

# Postgres connection string. REQUIRED in staging/production.
DATABASE_URL=

# Optional PEM CA bundle for the Postgres connection. When set, the server
# certificate is VERIFIED (closes the MITM gap); when empty, TLS encrypts but
# doesn't verify (the managed-provider default).
DATABASE_CA_CERT=

# Where operational data (leads/bookings/payments) lives:
#   sheets   — legacy Google-Sheets datastore (default)
#   dual     — Postgres is the source of truth, Sheets kept as a mirror (RECOMMENDED in production)
#   postgres — Postgres only
OPERATIONAL_STORE=dual

# Soft cap on NEW signups (0 = unlimited). Keeps a pilot invite-only and stays
# under Google's ~100-user cap for unverified sensitive scopes.
MAX_WORKSPACES=0

# Comma-separated emails allowed into the /admin control dashboard (workspace
# overview + manual wallet top-ups). Empty = admin surface disabled.
ADMIN_EMAILS=

# Platform support WhatsApp (digits incl. country code, e.g. 919876543210).
# When set, artists get a one-tap "Request a top-up on WhatsApp" button in the
# Wallet tab — the manual-recharge loop while online top-ups are off.
SUPPORT_WHATSAPP=

# 32+ char random secret used to encrypt OAuth tokens at rest (AES-256-GCM).
# REQUIRED in staging/production. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Observability (optional). Set SENTRY_DSN to forward errors to Sentry; when
# empty, errors are still structured-logged to stdout (Railway captures them).
LOG_LEVEL=info
SENTRY_DSN=

# Public contact email shown on the /legal/* pages for privacy & data requests.
# Defaults to the owner email if unset; set a branded inbox before going live.
LEGAL_CONTACT_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_PATH=/auth/google/callback
GOOGLE_MAPS_API_KEY=
WATI_WEBHOOK_SECRET=
MANYCHAT_WEBHOOK_SECRET=

# Gupshup — per-message WhatsApp pipe (Meta BSP; no monthly fee, no Meta app
# review on our side). Sign up at gupshup.io, create a WhatsApp app, and copy:
#   GUPSHUP_API_KEY       — account API key (dashboard → profile → API key)
#   GUPSHUP_APP_NAME      — the Gupshup app name
#   GUPSHUP_SOURCE_NUMBER — your WhatsApp business number, digits only incl.
#                           country code (e.g. 919876543210)
# Direct Meta credentials (WA_ACCESS_TOKEN + WA_PHONE_NUMBER_ID) take priority
# when both are set. NOTE: when sending via Gupshup, the template-name fields in
# app settings must hold Gupshup TEMPLATE IDs (from the Gupshup templates page).
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
XAI_API_KEY=
XAI_MODEL=grok-4.20-reasoning

# Google Business Profile auto-sync for the Reviews agent. Leave blank to run in
# assisted mode (AI drafts replies you post in one tap — works today). Set to 1
# only AFTER: (a) your GCP project is allowlisted for the Business Profile API
# (apply at developers.google.com/my-business — approval takes days/weeks), and
# (b) you add the https://www.googleapis.com/auth/business.manage scope to
# GOOGLE_OAUTH_SCOPES below so artists grant review-management access.
GMB_API_ENABLED=

# Razorpay credits wallet. Use rzp_test_* keys to trial top-ups with no real
# money (test cards: razorpay.com/docs/payments/payments/test-card-details).
# Switch to rzp_live_* keys to charge for real. The webhook secret is set when
# you add the webhook in the Razorpay dashboard pointing at /webhooks/razorpay
# and subscribe to the payment.captured event.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Usage metering is always on (messages and AI actions record credit debits).
# Leave BILLING_ENFORCED blank to TRACK usage without blocking anything — the
# safe default so no workspace is ever cut off unexpectedly. Set to 1 to start
# blocking metered actions once a workspace runs out of credits.
BILLING_ENFORCED=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_PATH=/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_INSTAGRAM_CONFIG_ID=
META_WHATSAPP_CONFIG_ID=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
LEEGALITY_CREATE_URL=
LEEGALITY_DETAILS_URL=
LEEGALITY_API_KEY=
LEEGALITY_API_KEY_HEADER=X-Auth-Token
LEEGALITY_WEBHOOK_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive.file
